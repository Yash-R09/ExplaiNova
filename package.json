{
  "name": "explainova-local",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:configure-app": "node scripts/configure-local-auth.mjs",
    "db:migrate": "supabase migration up",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --schema public > apps/web/src/lib/supabase/database.types.ts",
    "db:lint": "supabase db lint --schema public,private --level warning --fail-on warning",
    "app:dev": "npm --prefix apps/web run dev",
    "app:build": "npm --prefix apps/web run build",
    "app:typecheck": "npm --prefix apps/web run typecheck",
    "app:test": "npm --prefix apps/web test",
    "app:test:integration": "npm --prefix apps/web run test:integration",
    "app:test:signup": "npm --prefix apps/web run test:signup",
    "app:test:recovery": "npm --prefix apps/web run test:recovery",
    "app:test:projects": "npm --prefix apps/web run test:projects",
    "start": "node --env-file-if-exists=.env server.mjs",
    "sample": "node --env-file-if-exists=.env pipeline.mjs sample",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "supabase": "3.0.0"
  }
}
