{
  "name": "@explainova/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:integration": "node test/session.integration.mjs",
    "test:signup": "node test/signup.integration.mjs",
    "test:recovery": "node test/recovery.integration.mjs",
    "test:projects": "node test/projects.integration.mjs",
    "test:planning": "node test/planning.integration.mjs",
    "test:trash": "node test/project-trash.integration.mjs",
    "test:preferences": "node test/project-preferences.integration.mjs",
    "test:search": "node test/project-search.integration.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
