# Copy to .env.local; never commit real values.
# These values are browser-safe. Use the local publishable (or legacy anon) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# This controls secure cookies; use HTTPS for hosted deployments.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Never put a service-role/secret key or provider/R2 credentials in NEXT_PUBLIC_.
